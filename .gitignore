# Python
__pycache__/
*.py[cod]
*$py.class

# 选股 skill 每日运行产物（创新高/涨停/缩量回踩/市值/Q2/抗跌等结果 JSON，不入库）
.claude/skills/**/data/
.claude/skills/*/output/

# trade-review 运行缓存与输出（kline_cache 8.3MB 不入库；history.json 基线小，保留）
docs/trade-review/kline_cache.json
docs/trade-review/output/

# 敏感账户数据（含账户号字段，禁止入库；通配防文件名带日期/序号变体漏网）
docs/*.xls
docs/*.xlsx
*.xls
*.xlsx

# 浏览器自动化工具产物（playwright MCP），不入库
.playwright-mcp/
